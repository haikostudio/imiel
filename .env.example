# iMiel - Environment Variables
# Copy this file to .env and fill in the values

# Encryption key for mail account credentials stored in PocketBase
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PocketBase admin credentials (production)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# PocketBase URL (base locale lancee par `npm run dev:pb`, port 8090)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090

# Public-facing application URL
NEXT_PUBLIC_APP_URL=http://localhost:13000

# Mail worker URLs
WORKER_INTERNAL_URL=http://127.0.0.1:4001
MAIL_WORKER_URL=http://127.0.0.1:4001

# Google OAuth2 (for Gmail IMAP/SMTP access)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rspamd spam filtering (optional, filtering disabled if unavailable)
RSPAMD_URL=http://127.0.0.1:11334
# Score Rspamd a partir duquel un mail est spam meme sans LLM (fallback)
RSPAMD_HARD_SPAM_SCORE=15

# OpenRouter API key (toutes les fonctionnalites IA : chat, suggest, correct,
# brief, classifier spam). Modele DeepSeek par defaut, configurable via
# OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# Modele des travaux d'ARRIERE-PLAN du worker (tri spam, categories + niveau
# d'importance, suivi, recap du matin, newsletters, memoire des contacts).
# Vide = defaut du code (deepseek/deepseek-v4.1-flash-1017, retenu sur 100 vrais
# mails : le plus juste, ~3x moins cher que deepseek-chat-v3). Une variable
# dediee (OPENROUTER_MODEL_TRACKING, _DIGEST, _NEWSLETTER, _CONTACT_MEMORY,
# _CLASSIFY, _CATEGORIZE) prime si elle est posee. N'affecte PAS le chat.
OPENROUTER_MODEL_BACKGROUND=
# Modele dedie a la traduction / detection de langue (rapide + bon marche).
# Par defaut Gemini 2.5 Flash Lite. Mettre vide pour reutiliser OPENROUTER_MODEL.
OPENROUTER_TRANSLATE_MODEL=google/gemini-2.5-flash-lite
# Modeles dedies aux notes IA de discussion (thread briefs), selon le type
# de mail detecte (newsletter / conversation / single). Mettre vide pour
# reutiliser OPENROUTER_MODEL. Gemini Flash Lite par defaut pour newsletter
# (sortie structuree longue, bon marche, plus performant que DeepSeek sur ce
# type de contenu).
OPENROUTER_MODEL_NEWSLETTER=
OPENROUTER_MODEL_CONVERSATION=
OPENROUTER_MODEL_SINGLE=

# Classifieur spam LLM (mail-worker, sync). Mettre "false" pour desactiver.
LLM_CLASSIFIER_ENABLED=true


# Application iPhone : notifications APNs (cle d'equipe .p8, Team ID, Key ID).
# APNS_KEY_P8_BASE64 = contenu du fichier .p8 encode en base64 (une ligne).
# APNS_PRODUCTION=true pour TestFlight / App Store, false pour un build Xcode.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_BASE64=
APNS_BUNDLE_ID=studio.haiko.imiel
APNS_PRODUCTION=true
