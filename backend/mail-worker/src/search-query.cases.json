[
  { "q": "from:alice@x.fr facture edf is:unread has:attachment after:2025-01-01",
    "expect": { "from": ["alice@x.fr"], "freeText": "facture edf", "isUnread": true, "hasAttachment": true, "after": "2025-01-01", "errors": [] } },
  { "q": "FROM:Alice IS:Starred HAS:Attachment",
    "expect": { "from": ["Alice"], "isStarred": true, "hasAttachment": true, "freeText": "", "errors": [] } },
  { "q": "from:alice from:bob from:ALICE",
    "expect": { "from": ["alice", "bob"], "errors": [] } },
  { "q": "from:\"Paul Dupont\" subject:\"compte rendu\"",
    "expect": { "from": ["Paul Dupont"], "subject": ["compte rendu"], "errors": [] } },
  { "q": "inovi: 10:30 Re:devis",
    "expect": { "freeText": "inovi: 10:30 Re:devis", "errors": [] } },
  { "q": "has:pdf",
    "expect": { "hasAttachment": false, "errors": [{ "code": "unknownValue", "token": "has:pdf" }] } },
  { "q": "is:autre budget",
    "expect": { "freeText": "budget", "errors": [{ "code": "unknownValue", "token": "is:autre" }] } },
  { "q": "is:read",
    "expect": { "isRead": true, "errors": [] } },
  { "q": "is:read is:unread",
    "expect": { "errors": [{ "code": "conflict", "token": "is:read is:unread" }] } },
  { "q": "from:",
    "expect": { "from": [], "errors": [{ "code": "emptyValue", "token": "from:" }] } },
  { "q": "after:01/03/2025 before:15.03.2025",
    "expect": { "after": "2025-03-01", "before": "2025-03-15", "errors": [] } },
  { "q": "after:2025/3/1",
    "expect": { "after": "2025-03-01", "errors": [] } },
  { "q": "after:2025-02-30",
    "expect": { "after": "", "errors": [{ "code": "invalidDate", "token": "after:2025-02-30" }] } },
  { "q": "before:demain",
    "expect": { "before": "", "errors": [{ "code": "invalidDate", "token": "before:demain" }] } },
  { "q": "after:13/13/2025",
    "expect": { "errors": [{ "code": "invalidDate", "token": "after:13/13/2025" }] } },
  { "q": "after:2024-02-29",
    "expect": { "after": "2024-02-29", "errors": [] } },
  { "q": "after:2025-06-01 before:2025-01-01",
    "expect": { "errors": [{ "code": "dateOrder", "token": "after:2025-06-01 before:2025-01-01" }] } },
  { "q": "after:2025-01-01 after:2025-03-01",
    "expect": { "after": "2025-03-01", "errors": [] } },
  { "q": "has:attachment",
    "expect": { "hasAttachment": true, "freeText": "", "errors": [] } },
  { "q": "\"rendez vous\" chantier",
    "expect": { "freeText": "\"rendez vous\" chantier", "errors": [] } }
]
