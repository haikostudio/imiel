{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iMiel",
  "version": "1.0.5",
  "identifier": "studio.haiko.imiel.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "iMiel - votre boite mail",
    "longDescription": "iMiel : votre boite mail moderne, disponible sur le bureau."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMjgyODk5QzkyNUZDMjMKUldRai9DWEptU2dvUVBoNTFSTFVxTEI5Y1piUWVhTnFwaFZRL052Ly9vR3JkOXpKNFk2SC9BbkIK",
      "endpoints": [
        "https://getimiel.com/mises-a-jour/latest.json",
        "https://sync.getimiel.com/v1/mises-a-jour/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
